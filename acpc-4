int maxSum = INT_MIN;
int rows, cols;

void find(int i, int j, int sum, vector<vector<int>> &grid)
{
    if (i < 0 || j < 0 || i >= rows || j >= cols)
        return;

    sum += grid[i][j];

    if (i == rows - 1 && j == cols - 1)
    {
        maxSum = max(sum, maxSum);
    }

    find(i + 1, j, sum, grid);
    find(i, j + 1, sum, grid);

    sum -= grid[i][j];
}

