#include <bits/stdc++.h>
    using namespace std;
#define int long long

using ll = long long;
const int MOD = 1e9 + 7;

bool check(int ind, int sum, vector<int> &nums, int k)
{
    if (sum == k)
        return true;
    if (sum > k)
        return false;
    if (ind == nums.size())
        return false;

    for (int i = ind; i < nums.size(); i++)
    {
        sum += nums[i];
        if (check(i + 1, sum, nums, k))
        {
            return true;
        }
        sum -= nums[i];
    }
    return false;
}

void solve()
{
    int n, k;
    cin >> n >> k;
    vector<int> arr(n);
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    if (check(0, 0, arr, k))
    {
        cout << "YES\n";
    }
    else
    {
        cout << "NO\n";
    }
}

int32_t main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    cin >> t;
    while (t--)
        solve();

    return 0;
}

