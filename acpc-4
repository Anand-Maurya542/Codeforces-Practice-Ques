#include <bits/stdc++.h>
    using namespace std;
#define int long long

using ll = long long;
const int MOD = 1e9 + 7;

int largest = -1;

bool checkTime(vector<int> &temp)
{
    if (temp[0] > 2)
        return false;
    if (temp[0] == 2 && temp[1] > 3)
        return false;
    if (temp[2] > 5)
        return false;
    return true;
}

void permi(vector<bool> &used, vector<int> &nums, vector<int> &temp)
{
    if (temp.size() == 4)
    {
        // check valid
        if (checkTime(temp))
        {
            int time = temp[0] * 1000 + temp[1] * 100 + temp[2] * 10 + temp[3];
            largest = max(time, largest);
        }
        return;
    }

    for (int i = 0; i < nums.size(); i++)
    {
        if (used[i])
            continue;

        temp.push_back(nums[i]);
        used[i] = true;
        permi(used, nums, temp);
        temp.pop_back();
        used[i] = false;
    }
}

void solve()
{
    vector<int> nums(4);
    for (int i = 0; i < 4; i++)
    {
        cin >> nums[i];
    }
    vector<bool> used(4, false);
    vector<int> temp;
    permi(used, nums, temp);

    if (largest == -1)
    {
        cout << -1 << endl;
        return;
    }
    else
    {
        int d = largest % 10;
        largest /= 10;
        int c = largest % 10;
        largest /= 10;
        int b = largest % 10;
        largest /= 10;
        int a = largest;
        cout << a << b << ":" << c << d << endl;
    }
}

