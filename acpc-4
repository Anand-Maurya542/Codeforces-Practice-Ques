void find(int ind, int sum, int packets, vector<int> &arr, int x, int &mini)
{
    if (sum == x)
    {
        mini = min(mini, packets);
        return;
    }

    if (sum > x)
        return;

    if (ind == arr.size())
        return;

    // nhi liya
    find(ind + 1, sum, packets, arr, x, mini);

    // packets liya
    find(ind, sum + arr[ind], packets + 1, arr, x, mini);
}

void solve()
{
    int n, x;
    cin >> n >> x;
    vector<int> arr(n);
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    int mini = INT_MAX;
    find(0, 0, 0, arr, x, mini);

    if (mini == INT_MAX)
    {
        cout << -1 << endl;
        return;
    }
    cout << mini << endl;
}

