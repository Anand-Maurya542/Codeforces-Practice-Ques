#include <bits/stdc++.h>
    using namespace std;
#define int long long

using ll = long long;
const int MOD = 1e9 + 7;

int n, k, s;
unordered_map<int, vector<int>> mp;
int total = 0;

void solve(int ind, int sum, unordered_set<int> &used, vector<int> &nums)
{
    if (sum == s && used.size() == k)
    {
        total++;
        return;
    }
    if (sum > s || used.size() > k || ind >= nums.size())
        return;

    for (int i = ind; i < nums.size(); i++)
    {
        if (used.find(i) != used.end())
            continue;

        if (mp.find(i) != mp.end())
        {
            vector<int> temp = mp[i];
            bool check = false;
            for (auto num : temp)
            {
                if (used.find(num) != used.end())
                {
                    check = true;
                }
            }
            if (check)
                continue;
        }

        // not used and not contradict
        sum += nums[i];
        used.insert(i);
        solve(i + 1, sum, used, nums);
        sum -= nums[i];
        used.erase(i);
    }
}

void solve1()
{
    cin >> n >> k >> s;
    vector<int> nums(n);
    for (int i = 0; i < n; i++)
        cin >> nums[i];

    int m;
    cin >> m;
    for (int i = 0; i < m; i++)
    {
        int a, b;
        cin >> a >> b;
        a--;
        b--;
        mp[a].push_back(b);
        mp[b].push_back(a);
    }

    unordered_set<int> used;
    solve(0, 0, used, nums);

    cout << total << endl;
}

int32_t main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;
    while (t--)
        solve1();

    return 0;
}

